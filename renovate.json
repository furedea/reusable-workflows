{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>furedea/renovate-config"],
  "customManagers": [
    {
      "description": "Update tool versions pinned in workflow inputs, marked by a '# renovate: depName=<owner/repo>' comment",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "Update the nixpkgs revision of nix-lint to the head of nixos-unstable",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/nix-lint\\.yml$/"],
      "matchStrings": ["NIXPKGS_REV: (?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "nixpkgs",
      "packageNameTemplate": "https://github.com/NixOS/nixpkgs",
      "currentValueTemplate": "nixos-unstable"
    }
  ]
}
