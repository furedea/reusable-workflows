{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>furedea/renovate-config"],
  "customManagers": [
    {
      "description": "Update the zizmor version pinned in workflow inputs, marked by a '# renovate: depName=<owner/repo>' comment",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "Update the nixpkgs revision of nix-lint, gha-lint and ast-grep to the head of nixos-unstable",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/(?:nix-lint|gha-lint|ast-grep)\\.yml$/"],
      "matchStrings": ["NIXPKGS_REV: (?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "nixpkgs",
      "packageNameTemplate": "https://github.com/NixOS/nixpkgs",
      "currentValueTemplate": "nixos-unstable"
    },
    {
      "description": "Update the agent-config commit that ast-grep.yml applies to the head of main",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ast-grep\\.yml$/"],
      "matchStrings": ["# renovate: depName=(?<depName>\\S+)\\n\\s+default: (?<currentDigest>[0-9a-f]{40})"],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/furedea/agent-config",
      "currentValueTemplate": "main"
    }
  ]
}
